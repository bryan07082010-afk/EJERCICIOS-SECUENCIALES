Algoritmo NumerosPrimos
	
    Escribir "Digite un numero:"
    Leer nume
	
    Escribir "Numeros primos hasta ", nume, ":"
	
    Para i = 2 Hasta nume Hacer
		
        divisores = 0
		
        Para j = 1 Hasta i Hacer
            Si i MOD j = 0 Entonces
                divisores = divisores + 1
            FinSi
        FinPara
		
        Si divisores = 2 Entonces
            Escribir i
        FinSi
		
    FinPara
	
    divisores = 0
	
    Para j = 1 Hasta nume Hacer
        Si nume MOD j = 0 Entonces
            divisores = divisores + 1
        FinSi
    FinPara
	
    Si divisores = 2 Entonces
        Escribir "El numero ", nume, " SI es primo"
    Sino
        Escribir "El numero ", nume, " NO es primo"
    FinSi
	
FinAlgoritmo
